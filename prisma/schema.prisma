// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite" // or "postgresql" for production
}

model Brand {
  id          String    @id @default(uuid())
  name        String    @unique
  slug        String    @unique
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id            String               @id @default(uuid())
  name          String
  slug          String               @unique
  brandId       String?
  brand         Brand?               @relation(fields: [brandId], references: [id], onDelete: SetNull)
  brandName     String               // Stored directly for fast indexed queries
  description   String
  notes         String?              // JSON stringified array of scent notes (Top, Heart, Base)
  ingredients   String?
  imageBg       String
  type          PerfumeType
  category      Category
  gender        Gender
  volume        String?              @default("100ml")
  longevity     Longevity
  sillage       Sillage              @default(MEDIUM)
  price         Float                @default(0.0)
  rating        Float                @default(4.5)
  reviews       Int                  @default(0)
  stock         Int                  @default(50)
  status        ProductStatus        @default(AVAILABLE)
  orderItems    OrderItem[]
  interactions  ProductInteraction[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([brandName])
  @@index([category])
  @@index([gender])
}

model User {
  id           String               @id @default(uuid())
  name         String
  email        String               @unique
  password     String
  role         Role                 @default(CUSTOMER)
  status       UserStatus           @default(ACTIVE)
  phone        String?
  address      String?
  preference   String?              // e.g. "Fresh & Citrus, Woody" for personalized recommendations
  orders       Order[]
  interactions ProductInteraction[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
}

model Order {
  id          String        @id @default(uuid())
  date        DateTime      @default(now())
  total       Float
  status      OrderStatus   @default(PENDING)
  buyerId     String
  buyer       User          @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  items       OrderItem[]
  transaction Transaction[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
}

model OrderItem {
  id          String        @id @default(uuid())
  orderId     String
  order       Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?      @relation(fields: [productId], references: [id], onDelete: SetNull)
  name        String
  quantity    Int           @default(1)
  volume      String
  price       Float
  createdAt   DateTime      @default(now())
}

model Transaction {
  id          String            @id @default(uuid())
  orderId     String
  order       Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customer    String
  date        DateTime          @default(now())
  status      TransactionStatus @default(PENDING)
  amount      Float
  createdAt   DateTime          @default(now())
}

model ProductInteraction {
  id          String            @id @default(uuid())
  sessionId   String            // Anonymous or authenticated session ID
  userId      String?
  user        User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId   String
  product     Product           @relation(fields: [productId], references: [id], onDelete: Cascade)
  action      InteractionAction // VIEW, CLICK, CART_ADD, PURCHASE, SEARCH_SELECT, LIKE
  dwellTimeMs Int?              // Time spent on product details in milliseconds
  weight      Float             @default(1.0)
  createdAt   DateTime          @default(now())

  @@index([sessionId])
  @@index([userId])
  @@index([productId])
  @@index([action])
  @@index([createdAt])
}

enum InteractionAction {
  VIEW          @map("VIEW")
  CLICK         @map("CLICK")
  CART_ADD      @map("CART_ADD")
  PURCHASE      @map("PURCHASE")
  SEARCH_SELECT @map("SEARCH_SELECT")
  LIKE          @map("LIKE")
}

// --- ENUMS MATCHING output.json ---

enum PerfumeType {
  EDP                 @map("EDP")
  EDT                 @map("EDT")
  PARFUM              @map("Parfum")
  EXTRAIT_DE_PARFUM   @map("Extrait de Parfum")
  EXTRAIT             @map("Extrait")
  COLOGNE             @map("Cologne")
  ALCOHOL_FREE        @map("Alcohol-free")
  ATTAR               @map("Attar")
  CONCENTRATE         @map("Concentrate")
  OIL                 @map("Oil")
}

enum Category {
  FRESH_CITRUS        @map("Fresh & Citrus")
  WOODY               @map("Woody")
  GOURMAND            @map("Gourmand")
  FLORAL              @map("Floral")
  ORIENTAL_AMBER      @map("Oriental & Amber")
  OUD_RICH_WOODS      @map("Oud & Rich Woods")
  LEATHER             @map("Leather")
  AROMATIC_FOUGERE    @map("Aromatic / Fougère")
  OTHER               @map("Other")
  UNKNOWN             @map("Unknown")
}

enum Gender {
  MALE    @map("Male")
  FEMALE  @map("Female")
  UNISEX  @map("Unisex")
}

enum Longevity {
  STRONG        @map("Strong")
  MEDIUM        @map("Medium")
  LIGHT         @map("Light")
  VERY_STRONG   @map("Very Strong")
}

enum Sillage {
  VERY_LIGHT  @map("Very Light")
  LIGHT       @map("Light")
  MEDIUM      @map("Medium")
  STRONG      @map("Strong")
  VERY_STRONG @map("Very Strong")
}

enum Role {
  CUSTOMER @map("Customer")
  ADMIN    @map("Admin")
}

enum UserStatus {
  ACTIVE    @map("Active")
  SUSPENDED @map("Suspended")
}

enum ProductStatus {
  AVAILABLE    @map("Available")
  OUT_OF_STOCK @map("Out of Stock")
  LOW_STOCK    @map("Low Stock")
  IN_STOCK     @map("In Stock")
  COMING_SOON  @map("Coming Soon")
}

enum OrderStatus {
  PENDING    @map("Pending")
  PROCESSING @map("Processing")
  SHIPPED    @map("Shipped")
  DELIVERED  @map("Delivered")
  CANCELLED  @map("Cancelled")
}

enum TransactionStatus {
  PENDING   @map("Pending")
  PAID      @map("Paid")
  FAILED    @map("Failed")
  REFUNDED  @map("Refunded")
  COMPLETED @map("Completed")
}
